{
    "name": "payambridge/laravel",
    "description": "Laravel integration for PayamBridge.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "payambridge/sdk": "^0.1 || dev-main",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0"
    },
    "autoload": {"psr-4": {"PayamBridge\\Laravel\\": "src/"}},
    "extra": {"laravel": {"providers": ["PayamBridge\\Laravel\\PayamBridgeServiceProvider"], "aliases": {"PayamBridge": "PayamBridge\\Laravel\\Facades\\PayamBridge"}}},
    "config": {"sort-packages": true, "allow-plugins": false}
}
