{
    "name": "payambridge/sdk",
    "description": "Capability-based Iranian messenger SDK for PHP, with a separate Laravel bridge.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Required by the optional durable SQLite polling inbox.",
        "payambridge/laravel": "Laravel service provider, named connections and notification channel."
    },
    "autoload": {
        "psr-4": {
            "PayamBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayamBridge\\Tests\\": "tests/",
            "PayamBridge\\Laravel\\": "packages/laravel/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --debug --memory-limit=512M",
        "lint": "pint --test",
        "format": "pint",
        "inventory": "@php tools/inventory.php",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test",
            "@inventory",
            "@test:archive"
        ],
        "test:repeat": [
            "@test",
            "@test",
            "@test"
        ],
        "test:consumer": [
            "@php tools/consumer-smoke.php php",
            "@php tools/consumer-smoke.php 12",
            "@php tools/consumer-smoke.php 13"
        ],
        "test:archive": "@php tools/archive-check.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false,
        "platform": {
            "php": "8.3.0"
        }
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.agents",
            "/.aws",
            "/.codex",
            "/.docs",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.vscode",
            "/vendor",
            "/.phpunit.cache",
            "/.phpstan-cache",
            "/coverage",
            "/.env",
            "/.env.*",
            "/composer.lock",
            "/tests",
            "/tools",
            "/phpunit.xml",
            "/phpstan.neon",
            "/pint.json",
            "/packages",
            "/CONTRIBUTING.md"
        ]
    },
    "keywords": [
        "php",
        "laravel",
        "sdk",
        "bale",
        "rubika",
        "eitaa",
        "messenger",
        "notifications"
    ],
    "homepage": "https://github.com/mohammadhejazirad/PayamBridge",
    "support": {
        "issues": "https://github.com/mohammadhejazirad/PayamBridge/issues",
        "source": "https://github.com/mohammadhejazirad/PayamBridge",
        "docs": "https://github.com/mohammadhejazirad/PayamBridge/blob/main/README.en.md"
    }
}
